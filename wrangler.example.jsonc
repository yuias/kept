// Template for the git-ignored `wrangler.jsonc`. Run `pnpm run setup` to copy
// it, then fill in the values marked below. Keep this file in sync when
// changing anything that is not environment-specific.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kept",
  "main": "./src/worker/index.ts",
  // Must not exceed the workerd version bundled with the installed wrangler.
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  // The Access application protects the custom domain only, so the workers.dev
  // route must stay off — it would be an unauthenticated way into the app.
  "workers_dev": false,
  "preview_urls": false,
  // FILL IN: the hostname to serve from. The zone must be on this account;
  // wrangler creates the DNS record and certificate on deploy. Access covers
  // the whole host, with no bypass policies, so every path needs an identity.
  "routes": [{ "pattern": "kept.example.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these prefixes reach the Worker; everything else is served
    // straight from static assets (with SPA fallback to index.html).
    "run_worker_first": ["/api/*", "/raw/*", "/img/*"]
  },
  // Weekly backup, JST 06:00 on Monday. Cron Triggers are evaluated in UTC, so
  // the weekday here is the day before the one the schedule reads as locally.
  // Cloudflare numbers weekdays 1 = Sunday through 7 = Saturday, which is off
  // by one from most cron systems; the abbreviation sidesteps the ambiguity.
  // The second entry is the daily trash purge at JST 03:00 (18:00 UTC). It must
  // equal TRASH_PURGE_CRON in src/worker/scheduled.ts, or nothing is purged.
  "triggers": {
    "crons": ["0 21 * * SUN", "0 18 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "kept-images"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "kept-backups"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kept-db",
      // FILL IN: the id printed by `wrangler d1 create kept-db`.
      // The placeholder is enough for local development.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // How long a backup written from now on is kept. The expiry is stamped onto
    // each object as it is written, so changing this never affects backups that
    // already exist — in either direction.
    "BACKUP_RETENTION_DAYS": 56,
    // FILL IN: the account the database lives in. The export API is reached
    // over HTTP, which the D1 binding does not expose, so the ids have to be
    // repeated here.
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    // FILL IN: must match `d1_databases[0].database_id` above.
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000000"
  },
  // Declared by name only. Values live in `.dev.vars` locally and are set with
  // `wrangler secret put` for deployments.
  "secrets": {
    "required": [
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_POLICY_AUD",
      "ALLOWED_EMAILS",
      "D1_EXPORT_API_TOKEN"
    ]
  }
}
